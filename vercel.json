{
  "buildCommand": "node scripts/validate-schema.js && node scripts/seo-menu.js && node scripts/seo-i18n.js",
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/ibiza-brunch-dubai/:path*",
      "destination": "/#events",
      "permanent": false
    },
    {
      "source": "/jazz-friday-dubai/:path*",
      "destination": "/#events",
      "permanent": false
    },
    {
      "source": "/:file(.+\\.md)",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/:dir(tests|scripts|\\.github)/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/:file(vercel|package|package-lock)\\.json",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "bheaven-website.vercel.app"
        }
      ],
      "destination": "https://bheavendubai.com/:path*",
      "permanent": true
    },
    {
      "source": "/ar",
      "destination": "/ar/menu/",
      "permanent": false
    },
    {
      "source": "/ar/",
      "destination": "/ar/menu/",
      "permanent": false
    },
    {
      "source": "/es",
      "destination": "/es/menu/",
      "permanent": false
    },
    {
      "source": "/es/",
      "destination": "/es/menu/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://www.googletagmanager.com https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://stats.g.doubleclick.net https://www.google.com; media-src 'self' blob: data:; frame-src 'self' https://www.google.com; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        }
      ]
    },
    {
      "source": "/menu/img/t/:file([0-9a-f]{12}\\.webp)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/menu/img/:file([0-9a-f]{12}\\.webp)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/menu/img/business-lunch/:file",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/menu/img/:file(business-lunch-[a-z]+\\.jpg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/menu/img/:file(shisha-[a-z0-9]+\\.webp)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/:page(menu|business-lunch)/:file(seo-es|seo-ar).html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/admin(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/pwa.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/icons/:file",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/:file([^/]+\\.(?:jpe?g|png|webp|JPG|PNG))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/:lang(ar|es)/:page(menu|business-lunch|shisha)",
      "destination": "/api/page?lang=:lang&page=:page"
    },
    {
      "source": "/:lang(ar|es)/:page(menu|business-lunch|shisha)/",
      "destination": "/api/page?lang=:lang&page=:page"
    }
  ]
}
