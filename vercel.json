{
  "redirects": [
    {
      "source": "/",
      "destination": "/menu/",
      "permanent": false
    },
    {
      "source": "/ar",
      "destination": "/ar/menu/",
      "permanent": false
    },
    {
      "source": "/ar/",
      "destination": "/ar/menu/",
      "permanent": false
    },
    {
      "source": "/es",
      "destination": "/es/menu/",
      "permanent": false
    },
    {
      "source": "/es/",
      "destination": "/es/menu/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/menu/img/:file([0-9a-f]{12}\\.webp)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/menu/img/business-lunch/:file",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/menu/img/:file(business-lunch-[a-z]+\\.jpg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/menu/img/:file(shisha-[a-z0-9]+\\.webp)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/admin(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/pwa.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/icons/:file",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/:lang(ar|es)/:page(menu|business-lunch|shisha)",
      "destination": "/api/page?lang=:lang&page=:page"
    },
    {
      "source": "/:lang(ar|es)/:page(menu|business-lunch|shisha)/",
      "destination": "/api/page?lang=:lang&page=:page"
    }
  ]
}
